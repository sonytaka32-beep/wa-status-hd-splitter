<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#95B183"> <!-- Warna Hijau Poster GTA SA -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER GTA SAN ANDREAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="GRAND"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:shadowColor="#000000"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="1"
                    android:layout_marginBottom="-15dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="THEFT"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:shadowColor="#000000"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="1"
                    android:layout_marginBottom="-15dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="AUTO"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:shadowColor="#000000"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="1"
                    android:layout_marginBottom="-15dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="San Andreas"
                    android:textColor="#000000"
                    android:textSize="54sp"
                    android:textStyle="bold"
                    android:shadowColor="#FFFFFF"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="1"
                    android:layout_marginBottom="10dp"/>

                <!-- Label Definitive Edition -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#A67B48"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="4dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.2"
                    android:text="T H E  S T A T U S  E D I T I O N"
                    android:textColor="#000000"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- KONTROL PANEL -->
            <!-- Tombol Pilih Media (Hitam & Putih) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickVideo"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#000000"
                    android:fontFamily="sans-serif-black"
                    android:text="ADD VIDEO"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickPhoto"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"
                    android:fontFamily="sans-serif-black"
                    android:text="ADD PHOTO"
                    android:textColor="#000000"
                    app:cornerRadius="0dp" />
            </LinearLayout>

            <!-- Kotak Informasi (Terminal Hitam) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="0dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp">

                <TextView
                    android:id="@+id/tvMediaInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="16dp"
                    android:text="[ NO MEDIA LOADED ]\nWaiting for input..."
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Kotak Rotasi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#000000"
                app:cardCornerRadius="0dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="ROTATION OVERRIDE"
                        android:textColor="#A67B48"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rgRotateMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbRotateAuto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:fontFamily="sans-serif-medium"
                            android:text="Auto Portrait (Bypass Gameplay)"
                            android:textColor="#FFFFFF" />

                        <RadioButton
                            android:id="@+id/rbRotateNone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Keep Original Aspect Ratio"
                            android:textColor="#FFFFFF" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Proses (Warna Emas San Andreas) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProcess"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="#A67B48"
                android:enabled="false"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="START BYPASS INJECTION"
                android:textColor="#000000"
                android:textSize="16sp"
                app:cornerRadius="0dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#000000"
                android:progressBackgroundTint="#FFFFFF"/>

            <TextView
                android:id="@+id/tvStatusLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="monospace"
                android:text="System: Idle..."
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Tombol Kirim WA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareWa"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:backgroundTint="#000000"
                android:enabled="false"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:text="SEND TO WHATSAPP"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:cornerRadius="0dp" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>