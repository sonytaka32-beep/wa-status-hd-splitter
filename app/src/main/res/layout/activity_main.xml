<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0616">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER GTA 6 VIBE -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/gts6_neon_bg" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gradient_neon" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.3"
                        android:text="S O N Y B A E   P R O J E C T"
                        android:textColor="#00F0FF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif-black"
                        android:text="STATUS HD+ V6"
                        android:textColor="#FF1E82"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:shadowColor="#FF000000"
                        android:shadowDx="4"
                        android:shadowDy="4"
                        android:shadowRadius="3"/>
                </LinearLayout>
            </RelativeLayout>

            <!-- KONTROL PANEL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Tombol Media -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickVideo"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#004D40"
                        android:fontFamily="sans-serif-black"
                        android:text="ADD VIDEO"
                        android:textColor="#00F0FF"
                        app:cornerRadius="12dp"
                        app:strokeColor="#00F0FF"
                        app:strokeWidth="1dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickPhoto"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="#311B92"
                        android:fontFamily="sans-serif-black"
                        android:text="ADD PHOTO"
                        android:textColor="#FF1E82"
                        app:cornerRadius="12dp"
                        app:strokeColor="#FF1E82"
                        app:strokeWidth="1dp"/>
                </LinearLayout>

                <!-- Panel Info -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#130D26"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#2D1A4A"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/tvMediaInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:padding="16dp"
                        android:text="[ NO MEDIA LOADED ]"
                        android:textColor="#B39DDB"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Panel Pengaturan -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    app:cardBackgroundColor="#130D26"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#2D1A4A"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="ROTATION OVERRIDE"
                            android:textColor="#00F0FF"
                            android:textSize="11sp" />

                        <RadioGroup
                            android:id="@+id/rgRotateMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/rbRotateAuto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:fontFamily="sans-serif-condensed"
                                android:text="Auto Portrait (For Landscape Gameplays)"
                                android:textColor="#E4E4E7" />

                            <RadioButton
                                android:id="@+id/rbRotateNone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:text="Keep Original Aspect Ratio"
                                android:textColor="#E4E4E7" />
                        </RadioGroup>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="#2D1A4A" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="AUTO-SPLIT DURATION"
                            android:textColor="#FF1E82"
                            android:textSize="11sp" />

                        <RadioGroup
                            android:id="@+id/rgSplitInterval"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <RadioButton
                                android:id="@+id/rb15Sec"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-condensed"
                                android:text="15s"
                                android:textColor="#E4E4E7" />

                            <RadioButton
                                android:id="@+id/rb30Sec"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="24dp"
                                android:checked="true"
                                android:fontFamily="sans-serif-condensed"
                                android:text="30s (Recommended)"
                                android:textColor="#E4E4E7" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tombol Proses -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProcess"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:backgroundTint="#FF1E82"
                    android:enabled="false"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="START BYPASS INJECTION"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:cornerRadius="12dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="16dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#00F0FF"
                    android:progressBackgroundTint="#2D1A4A"/>

                <TextView
                    android:id="@+id/tvStatusLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Terminal Status: Idle..."
                    android:textColor="#7E57C2"
                    android:textSize="12sp" />

                <!-- Tombol WhatsApp -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareWa"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:backgroundTint="#16A34A"
                    android:enabled="false"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:text="SEND TO WHATSAPP"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>