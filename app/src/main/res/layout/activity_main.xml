<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_status_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="14dp">

            <!-- Poster-like comic header, matching the screen-recorder app -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/bg_status_frame"
                android:padding="3dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/gts_sa_skyline" />

                <ImageView
                    android:layout_width="74dp"
                    android:layout_height="90dp"
                    android:layout_gravity="end|bottom"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cj_character" />
            </FrameLayout>

            <!-- Existing custom branding, scaled to match the compact reference layout -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_gta_wide" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="27dp"
                android:layout_marginTop="-3dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_sonybaeproject" />

            <ImageView
                android:layout_width="150dp"
                android:layout_height="21dp"
                android:layout_marginTop="-1dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_sonybae" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.10"
                android:text="STATUS VIDEO / PHOTO OPTIMIZER"
                android:textColor="#FFD0A46B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Compact media-picker row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickVideo"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_button_dark"
                    android:fontFamily="sans-serif-black"
                    android:text="ADD VIDEO"
                    android:textColor="#FFD5E9A8"
                    android:textSize="12sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="11dp"
                    app:strokeColor="#849B62"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickPhoto"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_button_dark"
                    android:fontFamily="sans-serif-black"
                    android:text="ADD PHOTO"
                    android:textColor="#E5C98A"
                    android:textSize="12sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="11dp"
                    app:strokeColor="#A28A50"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Status details card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="11dp"
                app:cardBackgroundColor="#E6101711"
                app:cardCornerRadius="13dp"
                app:cardElevation="3dp"
                app:strokeColor="#FF9A8050"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvMediaInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:lineSpacingExtra="1dp"
                    android:minHeight="54dp"
                    android:padding="12dp"
                    android:text="[ NO MEDIA LOADED ]\nSelect a video or photo to inspect."
                    android:textColor="#FFD9E4C9"
                    android:textSize="13sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Settings panel: original IDs retained for MainActivity -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#E6101711"
                app:cardCornerRadius="13dp"
                app:cardElevation="3dp"
                app:strokeColor="#FF9A8050"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="11dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="ROTATION MODE"
                        android:textColor="#E5C479"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgRotateMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rbRotate90"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:buttonTint="@color/status_radio_tint"
                            android:checked="true"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="2dp"
                            android:text="Force Portrait (rotate 90°)"
                            android:textColor="#FFE7E5DA"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/rbKeepOriginal"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:buttonTint="@color/status_radio_tint"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="2dp"
                            android:text="Keep Original Orientation"
                            android:textColor="#FFE7E5DA"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_status_divider" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:fontFamily="sans-serif-condensed"
                        android:text="OUTPUT DURATION LIMIT"
                        android:textColor="#E5C479"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerDurationLimit"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_status_spinner"
                        android:dropDownWidth="match_parent"
                        android:paddingStart="5dp"
                        android:paddingEnd="7dp"
                        android:popupBackground="#FF182019" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Start action, bright Grove green -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProcess"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_status_button"
                android:fontFamily="@font/pricedown"
                android:letterSpacing="0.04"
                android:enabled="false"
                android:text="START PROCESSING"
                android:textAllCaps="false"
                android:textColor="#FF10170E"
                android:textSize="23sp"
                app:backgroundTint="@null"
                app:cornerRadius="15dp" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="11dp"
                android:progressBackgroundTint="#775B4930"
                android:progressTint="#FFCFA35A"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvStatusLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="sans-serif-condensed"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="STATUS: IDLE"
                android:textColor="#FFB8C8A8"
                android:textSize="12sp" />

            <!-- Keep output/share action readily reachable -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareWa"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_status_button_wa"
                android:enabled="false"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.035"
                android:text="SEND TO WHATSAPP STATUS"
                android:textColor="#FFF3E4D6"
                android:textSize="14sp"
                app:backgroundTint="@null"
                app:cornerRadius="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_status_divider" />
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
