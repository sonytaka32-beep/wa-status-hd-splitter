<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS HD+ PRO"
            android:textColor="#22C55E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Anti-Blur Video + Foto + Auto-Split Tanpa Batas Durasi"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickVideo"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#16A34A"
                android:text="Pilih Video HD+"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnPickPhoto"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#2563EB"
                android:text="Pilih Foto HD+"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mode Jalur Upload WhatsApp:"
            android:textColor="#E2E8F0"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgQualityMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbAutoBypass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Auto-Lolos WA (720p ~5MB - Jernih Otomatis)"
                android:textColor="#F8FAFC" />

            <RadioButton
                android:id="@+id/rbForce1080p"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full HD 1080p (Wajib Ketuk Ikon HD di Atas WA)"
                android:textColor="#F8FAFC" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Interval Auto-Split Video Panjang:"
            android:textColor="#E2E8F0"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSplitInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb15Sec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 Detik (Ultra)"
                android:textColor="#F8FAFC" />

            <RadioButton
                android:id="@+id/rb30Sec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:checked="true"
                android:text="30 Detik"
                android:textColor="#F8FAFC" />

            <RadioButton
                android:id="@+id/rb60Sec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="60 Detik"
                android:textColor="#F8FAFC" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvMediaInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E293B"
            android:padding="14dp"
            android:text="Belum ada media dipilih."
            android:textColor="#38BDF8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnProcess"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#F59E0B"
            android:enabled="false"
            android:text="PROSES HD+ / AUTO SPLIT"
            android:textColor="#0F172A"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tvStatusLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: Menunggu file..."
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnShareWa"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#22C55E"
            android:enabled="false"
            android:text="KIRIM KE STATUS WHATSAPP"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>