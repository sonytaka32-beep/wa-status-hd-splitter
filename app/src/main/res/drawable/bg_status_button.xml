<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FFFFFF">
    <item>
        <layer-list>
            <!-- Bayangan bawah + border komik tebal -->
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF060E09" />
                    <corners android:radius="15dp" />
                    <stroke
                        android:width="3dp"
                        android:color="#FFB4C88A" />
                </shape>
            </item>
            <!-- Gradient hijau Grove Street -->
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:centerColor="#FF6E9A55"
                        android:endColor="#FF4A7A3C"
                        android:startColor="#FF9CC272" />
                    <corners android:radius="13dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#FFD7E8BC" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
