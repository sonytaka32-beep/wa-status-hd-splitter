<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bingkai komik tebal ala sampul GTA -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF06110B" />
            <stroke
                android:width="2dp"
                android:color="#FFBFD28A" />
        </shape>
    </item>
    <!-- Garis dalam tipis berwarna hijau zaitun -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#667E9A52" />
        </shape>
    </item>
</layer-list>
