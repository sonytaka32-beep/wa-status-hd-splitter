<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Border komik tebal di luar panel (hijau zaitun) -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF0B1410" />
            <corners android:radius="12dp" />
            <stroke
                android:width="3dp"
                android:color="#FFB4C88A" />
        </shape>
    </item>
    <!-- Latar dalam panel (hijau sangat gelap) -->
    <item android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#FF12211A"
                android:endColor="#FF0C1712"
                android:startColor="#FF16291F" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
