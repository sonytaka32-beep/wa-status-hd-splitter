<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Latar hijau gelap khas Grove Street -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#FF122A1C"
                android:endColor="#FF060F0A"
                android:startColor="#FF0A1A11" />
        </shape>
    </item>
    <!-- Cahaya hijau di bagian atas (glow) -->
    <item
        android:height="210dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:centerColor="#332B5C38"
                android:endColor="#00000000"
                android:startColor="#662B5C38" />
        </shape>
    </item>
    <!-- Bayangan hijau tua di bagian bawah -->
    <item
        android:height="190dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#33103320"
                android:endColor="#99102A1A"
                android:startColor="#00000000" />
        </shape>
    </item>
</layer-list>
