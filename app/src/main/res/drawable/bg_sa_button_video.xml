<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#26351B"/>
            <corners android:radius="14dp"/>
            <stroke android:width="2dp" android:color="#D5A64A"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#526438"
                android:endColor="#29391F"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#8D9A5A"/>
        </shape>
    </item>
</selector>