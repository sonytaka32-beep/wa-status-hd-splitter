<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#70401F"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#A95B32"
                android:endColor="#65351F"/>
            <corners android:radius="14dp"/>
            <stroke android:width="1dp" android:color="#D5A64A"/>
        </shape>
    </item>
</selector>