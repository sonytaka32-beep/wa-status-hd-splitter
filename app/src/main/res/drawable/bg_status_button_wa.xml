<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#66FFFFFF">
    <item>
        <layer-list>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF060E09" />
                    <corners android:radius="15dp" />
                    <stroke
                        android:width="3dp"
                        android:color="#FFB4C88A" />
                </shape>
            </item>
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:centerColor="#FF3FA05C"
                        android:endColor="#FF22703F"
                        android:startColor="#FF5FC57C" />
                    <corners android:radius="13dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#FFD3F0D9" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
