<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#292044"
                android:centerColor="#A94C32"
                android:endColor="#F0A04B"/>
        </shape>
    </item>

    <item android:gravity="bottom">
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00000000"
                android:endColor="#B0000000"/>
        </shape>
    </item>

</layer-list>